from pyspark.sql.functions import sum, count, col

storage_account = "pocretail01"
container = "retail"

df_silver = spark.read.parquet("abfss://retail@pocretail01.dfs.core.windows.net/silver/")

df_daily_revenue = (
    df_silver.groupBy("event_timestamp")
    .agg(sum("amount").alias("daily_revenue"), count("*").alias("total_purchases"))
)

df_daily_revenue.show()

df_daily_revenue.write.mode("overwrite").parquet(
        f"abfss://{container}@{storage_account}.dfs.core.windows.net/"
        "gold")

