from pyspark.sql.functions import col, to_date, lower, trim

#Ingest Data from ADLS into Dataframe

storage_account = "pocretail01"
container = "retail"

parquet_path = (
    f"abfss://{container}@{storage_account}.dfs.core.windows.net/"
    "bronze/gmmind2026-ops/synapse_retail_project/refs/heads/main/"
    "retail_transactions_bronze.parquet")

df_bronze = spark.read.parquet(parquet_path)

bronze_row_count = df_bronze.count()

print("Bronze row count", bronze_row_count)

#Remove Null Values
#Select only Purchase events
#Convert timesatmp and lower formats

df_silver = (df_bronze
    .filter(
        (col("customer_id").isNotNull()) &
        (trim(col("customer_id").cast("string")) != "") &
        (col("amount").isNotNull()) &
        (trim(col("amount").cast("string")) != "")
        )
    .filter(col("event_type") == "purchase")
    .withColumn("event_timestamp", to_date(col("event_timestamp")))
    .withColumn("payment_method",lower(col("payment_method")))
    .withColumn("amount",col("amount").cast("float"))
    .select(
        "event_id","customer_id","event_timestamp","product_id",
        "product_category","amount","payment_method","location",)
)

df_silver.write.mode("overwrite").parquet(
        f"abfss://{container}@{storage_account}.dfs.core.windows.net/"
        "silver")
        
df_silver.show()

silver_row_count = df_silver.count()

print("Silver row count", silver_row_count)
